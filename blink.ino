// Настраиваем вывод 13 (к нему подключен встроенный светодиод на большинстве плат Arduino)
void setup() {
  pinMode(13, OUTPUT); 
}

// Основной цикл, который выполняется бесконечно
void loop() {
  digitalWrite(13, HIGH);  // Включаем светодиод (подаем 5V)
  delay(1000);             // Ждем 1 секунду (1000 миллисекунд)
  digitalWrite(13, LOW);   // Выключаем светодиод (подаем 0V)
  delay(1000);             // Ждем еще 1 секунду
}
